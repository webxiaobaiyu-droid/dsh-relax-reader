{
  "extends": "./tsconfig.host.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "outDir": "lib/types",
    "rootDir": "src",
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/index.ts",
    "src/types.ts",
    "src/errors.ts",
    "src/fetcher.ts",
    "src/parser.ts",
    "src/store.ts",
    "src/sources.ts",
    "src/search.ts"
  ]
}
